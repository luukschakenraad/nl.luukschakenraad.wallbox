{
  "name": {
    "en": "Wallbox Charger",
    "nl": "Wallbox Laadpaal",
    "fr": "Borne de charge Wallbox"
  },
  "class": "evcharger",
  "capabilities": [
    "locked",
    "evcharger_charging_state",
    "evcharger_charging",
    "measure_power",
    "measure_current",
    "max_charging_current",
    "meter_power.charged",
    "meter_power.total",
    "target_power",
    "target_power_mode",
    "status",
    "status_code",
    "car_connected",
    "eco_smart",
    "last_updated",
    "alarm_connectivity"
  ],
  "capabilitiesOptions": {
    "target_power": {
      "min": 0,
      "max": 22000,
      "step": 230,
      "excludeMin": 0,
      "excludeMax": 1380
    },
    "measure_current": {
      "title": {
        "en": "Charging current (flowing)",
        "nl": "Laadstroom (actueel)",
        "fr": "Courant de charge (actuel)"
      }
    },
    "alarm_connectivity": {
      "title": {
        "en": "Wallbox connection",
        "nl": "Wallbox-verbinding",
        "fr": "Connexion Wallbox"
      }
    },
    "meter_power.charged": {
      "title": {
        "en": "Energy this session",
        "nl": "Energie deze sessie",
        "fr": "Énergie de la session"
      }
    },
    "meter_power.total": {
      "title": {
        "en": "Energy charged total",
        "nl": "Totaal geladen energie",
        "fr": "Énergie totale chargée"
      }
    },
    "meter_power.green": {
      "title": {
        "en": "Green energy charged total",
        "nl": "Totaal geladen groene energie",
        "fr": "Énergie verte totale chargée"
      }
    }
  },
  "energy": {
    "evCharger": true,
    "meterPowerImportedCapability": "meter_power.total"
  },
  "images": {
    "xlarge": "/drivers/wallbox/assets/images/xlarge.png",
    "large": "/drivers/wallbox/assets/images/large.png",
    "small": "/drivers/wallbox/assets/images/small.png"
  },
  "icon": "/drivers/wallbox/assets/icon.svg",
  "settings": [
    {
      "id": "polling",
      "type": "number",
      "label": {
        "en": "Polling interval",
        "nl": "Pollinginterval",
        "fr": "Intervalle d'interrogation"
      },
      "hint": {
        "en": "How often Homey asks Wallbox for the charger status. Wallbox limits the requests per account, so a shorter interval is not possible. With several chargers on one account the interval is at least 60 s per charger.",
        "nl": "Hoe vaak Homey de status van de laadpaal bij Wallbox opvraagt. Wallbox beperkt het aantal verzoeken per account, daarom kan het niet korter. Met meerdere laadpalen op één account is het interval minstens 60 s per laadpaal.",
        "fr": "Fréquence à laquelle Homey demande le statut de la borne à Wallbox. Wallbox limite les requêtes par compte, un intervalle plus court n'est donc pas possible. Avec plusieurs bornes sur un même compte, l'intervalle est d'au moins 60 s par borne."
      },
      "value": 120,
      "min": 90,
      "max": 600,
      "units": {
        "en": "s",
        "nl": "s",
        "fr": "s"
      }
    }
  ],
  "pair": [
    {
      "id": "login_credentials",
      "template": "login_credentials",
      "options": {
        "logo": "icon.png",
        "usernameLabel": {
