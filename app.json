    "actions": [
      {
        "id": "change_ampere",
        "title": {
          "en": "Change charging current",
          "nl": "Verander laadsnelheid",
          "fr": "Modifier la vitesse de chargement"
        },
        "titleFormatted": {
          "en": "Set the charging current to [[ampere]]",
          "nl": "Zet de laadstroom op [[ampere]]",
          "fr": "Régler le courant de charge sur [[ampere]]"
        },
        "hint": {
          "en": "Sets the maximum charging current (6 A up to the charger's maximum, a fraction rounded down). Not possible while Homey Energy controls the charger. Result: sent, queued (an increase waits for the one-per-minute limit, seconds tells how long) or unchanged.",
          "nl": "Stelt de maximale laadstroom in (6 A tot het maximum van de laadpaal, een breuk naar beneden afgerond). Niet mogelijk terwijl Homey Energy de laadpaal regelt. Resultaat: sent (verzonden), queued (een verhoging wacht op de limiet van één per minuut, seconds zegt hoe lang) of unchanged (ongewijzigd).",
          "fr": "Règle le courant de charge maximal (6 A jusqu'au maximum de la borne, une fraction arrondie vers le bas). Impossible pendant que Homey Energy pilote la borne. Résultat : sent (envoyé), queued (une hausse attend la limite d'une par minute, seconds indique combien de temps) ou unchanged (inchangé)."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=wallbox"
          },
          {
            "name": "ampere",
            "type": "number",
            "title": {
              "en": "Current",
              "nl": "Stroom",
              "fr": "Courant"
            },
            "placeholder": {
              "en": "Current",
              "nl": "Ampere",
              "fr": "Ampère"
            },
            "min": 6,
            "max": 32,
            "step": 1
          }
        ],
        "tokens": [
          {
            "name": "result",
            "type": "string",
            "title": {
              "en": "Result",
              "nl": "Resultaat",
              "fr": "Résultat"
            },
            "example": "sent"
          },
          {
            "name": "amps",
            "type": "number",
            "title": {
              "en": "Current (A)",
              "nl": "Stroom (A)",
              "fr": "Courant (A)"
            },
            "example": 16
          },
          {
            "name": "seconds",
            "type": "number",
            "title": {
              "en": "Seconds until sent",
              "nl": "Seconden tot verzenden",
              "fr": "Secondes avant l'envoi"
            },
            "example": 0
          }
        ]
      },
